#!/usr/bin/env node
// Writes an account into Verdaccio's htpasswd file, in the format its
// htpasswd plugin writes, hashed with the bcrypt that plugin uses.
//
//   htpasswd-add <user>   adds the user, or replaces its password; the
//                         password is read from standard input
//   htpasswd-add --seed   run at start: creates the file with
//                         VERDACCIO_ADMIN_USER when there is no file yet
//
// Verdaccio reads the file again on every sign-in, so a change needs no
// restart.
'use strict';

const fs = require('node:fs');
const path = require('node:path');

const FILE = process.env.VERDACCIO_HTPASSWD || '/verdaccio/storage/htpasswd';
const VERDACCIO = process.env.VERDACCIO_MODULE || '/usr/local/lib/node_modules/verdaccio';

function bcrypt() {
  const plugin = path.dirname(require.resolve('verdaccio-htpasswd', { paths: [VERDACCIO] }));
  return require(require.resolve('bcryptjs', { paths: [plugin] }));
}

function fail(message) {
  process.stderr.write(`htpasswd-add: ${message}\n`);
  process.exit(1);
}

function write(user, password) {
  if (!user || user !== encodeURIComponent(user) || user.includes(':')) {
    fail(`"${user}" is not a valid user name: use letters, digits, - . _ ~`);
  }
  // Verdaccio's own minimum, for accounts it would create.
  if (!password || password.length < 3) fail('the password must be at least 3 characters');

  const hash = bcrypt().hashSync(password, 10);
  const line = `${user}:${hash}:autocreated ${new Date().toJSON()}`;

  const existing = fs.existsSync(FILE) ? fs.readFileSync(FILE, 'utf8') : '';
  const lines = existing.split('\n').filter((l) => l.trim() !== '');
  const kept = lines.filter((l) => l.split(':', 1)[0].trim() !== user);
  const replaced = kept.length !== lines.length;
  kept.push(line);

  const tmp = `${FILE}.tmp-${process.pid}`;
  fs.writeFileSync(tmp, kept.join('\n') + '\n', { mode: 0o600 });
  fs.renameSync(tmp, FILE);
  process.stdout.write(`htpasswd-add: ${replaced ? 'changed the password of' : 'added'} ${user}\n`);
}

const arg = process.argv[2];

if (arg === '--seed') {
  if (fs.existsSync(FILE)) process.exit(0);
  const user = process.env.VERDACCIO_ADMIN_USER;
  const password = process.env.VERDACCIO_ADMIN_PASSWORD;
  if (!user || !password) {
    process.stderr.write('htpasswd-add: no htpasswd file and no VERDACCIO_ADMIN_USER/PASSWORD; nobody can sign in\n');
    process.exit(0);
  }
  write(user, password);
} else if (arg && !arg.startsWith('-')) {
  const input = fs.readFileSync(0, 'utf8');
  write(arg, input.split(/\r?\n/, 1)[0]);
} else {
  fail('usage: htpasswd-add <user> (password on standard input), or htpasswd-add --seed');
}
