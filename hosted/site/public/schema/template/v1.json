{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "minCubeship": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "environment": {
      "default": "production",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "inputs": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "help": {
                "type": "string"
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "domain"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "help": {
                "type": "string"
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "text"
              },
              "default": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "help": {
                "type": "string"
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "help": {
                "type": "string"
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "choice"
              },
              "default": {
                "type": "string"
              },
              "options": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "options"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "help": {
                "type": "string"
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "secret"
              },
              "generate": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "help": {
                "type": "string"
              },
              "required": {
                "default": true,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "store"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "databases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "engine": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pgvector",
                "vectorchord",
                "pg_trgm",
                "btree_gin",
                "btree_gist",
                "bloom",
                "citext",
                "cube",
                "earthdistance",
                "fuzzystrmatch",
                "hstore",
                "intarray",
                "isn",
                "ltree",
                "pgcrypto",
                "seg",
                "tablefunc",
                "tsm_system_rows",
                "unaccent",
                "uuid-ossp",
                "dblink",
                "postgres_fdw",
                "pg_prewarm",
                "pgstattuple",
                "pg_buffercache",
                "pg_stat_statements"
              ]
            },
            "description": "Postgres extensions to create this database with. Permanent: they choose the image, and no later release of this template can add or remove one. \"vectorchord\" brings \"pgvector\" with it."
          },
          "username": {
            "type": "string"
          },
          "database": {
            "type": "string"
          },
          "expose": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "limits": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "number"
              },
              "memory": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "engine"
        ],
        "additionalProperties": false
      }
    },
    "stores": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "version": {
            "type": "string"
          },
          "buckets": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "number"
              },
              "memory": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    "apps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "image": {
            "type": "string"
          },
          "tag": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
          },
          "repo": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "build": {
            "type": "string",
            "enum": [
              "dockerfile",
              "railpack"
            ]
          },
          "dockerfile": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "health": {
            "type": "string"
          },
          "domains": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "host"
              ],
              "additionalProperties": false
            }
          },
          "attach": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "database": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "store": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "bucket": {
                  "type": "string"
                },
                "prefix": {
                  "default": "",
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "number"
              },
              "memory": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "additionalProperties": false
          },
          "scale": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "spread": {
            "type": "boolean"
          },
          "autoscale": {
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "cpu": {
                "type": "number"
              }
            },
            "required": [
              "max",
              "cpu"
            ],
            "additionalProperties": false
          },
          "volumes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            },
            "markdownDescription": "Paths inside the container whose contents survive deploys. **Available from Cubeship 0.7.0**: needs `minCubeship: \"0.7.0\"` or later."
          },
          "tcp": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "host": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1024,
                      "maximum": 65535
                    },
                    {
                      "type": "string",
                      "pattern": "^\\$\\{input\\.[a-zA-Z][a-zA-Z0-9_-]*\\}$"
                    }
                  ]
                }
              },
              "required": [
                "port"
              ],
              "additionalProperties": false
            },
            "markdownDescription": "Ports of the container published on a host port of the instance, for protocols that are not HTTP, such as SSH. `host` is 1024-65535, `${input.<key>}` naming a number input, or left out for the instance to pick one. The app runs as one copy. **Available from Cubeship 0.7.2**: needs `minCubeship: \"0.7.2\"` or later."
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "project",
    "apps"
  ],
  "additionalProperties": false,
  "if": {
    "not": {
      "required": [
        "minCubeship"
      ],
      "properties": {
        "minCubeship": {
          "pattern": "^\\s*(?:>=|>|\\^|~|=)?\\s*v?(?:(?:0\\.7\\.0-rc\\.(?:[6-9]|[1-9][0-9]+)|0\\.7\\.[1-9][0-9]*-[0-9A-Za-z.-]+|0\\.(?:[89]|[1-9][0-9]+)\\.[0-9]+-[0-9A-Za-z.-]+|[1-9][0-9]*\\.[0-9]+\\.[0-9]+-[0-9A-Za-z.-]+)|(?:0\\.(?:[7-9]|[1-9][0-9]+)(?:\\.(?:[0-9]+|[xX*]))?|[1-9][0-9]*(?:\\.(?:[0-9]+|[xX*])){0,2}))(?:\\s+<=?\\s*v?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z.-]+)?)?(?:\\s*\\|\\|\\s*(?:>=|>|\\^|~|=)?\\s*v?(?:(?:0\\.7\\.0-rc\\.(?:[6-9]|[1-9][0-9]+)|0\\.7\\.[1-9][0-9]*-[0-9A-Za-z.-]+|0\\.(?:[89]|[1-9][0-9]+)\\.[0-9]+-[0-9A-Za-z.-]+|[1-9][0-9]*\\.[0-9]+\\.[0-9]+-[0-9A-Za-z.-]+)|(?:0\\.(?:[7-9]|[1-9][0-9]+)(?:\\.(?:[0-9]+|[xX*]))?|[1-9][0-9]*(?:\\.(?:[0-9]+|[xX*])){0,2}))(?:\\s+<=?\\s*v?[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z.-]+)?)?)*\\s*$"
        }
      }
    }
  },
  "then": {
    "properties": {
      "apps": {
        "items": {
          "properties": {
            "volumes": {
              "not": {},
              "errorMessage": "Volumes are available from Cubeship 0.7.0. Set minCubeship: \"0.7.0\" or later, or an older instance would install this without its data surviving."
            }
          }
        }
      }
    }
  },
  "$id": "https://cubeship.dev/schema/template/v1.json",
  "title": "Cubeship template, version 1"
}
